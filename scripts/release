#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: %s vX.Y.Z\n' "$(basename "$0")" >&2
  printf 'Set DRY_RUN=1 to run all checks without creating or pushing a tag.\n' >&2
}

fail() {
  printf 'release: %s\n' "$1" >&2
  exit 1
}

if [[ $# -ne 1 ]]; then
  usage
  exit 2
fi

tag="$1"
[[ "$tag" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || {
  fail "version must match stable vX.Y.Z without leading zeroes or prerelease metadata: $tag"
}

dry_run="${DRY_RUN:-0}"
case "$dry_run" in
  0 | 1) ;;
  *) fail "DRY_RUN must be 0 or 1" ;;
esac

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || fail "run this command inside the repository"
cd "$repo_root"

[[ "$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)" == main ]] || {
  fail "release must start from the main branch"
}

ensure_clean() {
  local status
  status="$(git status --porcelain --untracked-files=all)"
  [[ -z "$status" ]] || {
    printf 'release: working tree is not clean:\n%s\n' "$status" >&2
    exit 1
  }
}

ensure_clean
printf 'release: fast-forwarding main from origin...\n'
git pull --ff-only origin main
ensure_clean

local_tag="$(git rev-parse --verify --quiet "refs/tags/$tag" || true)"
[[ -z "$local_tag" ]] || fail "local tag already exists: $tag"

remote_tag="$(git ls-remote --refs origin "refs/tags/$tag")" || {
  fail "could not inspect remote tag: $tag"
}
[[ -z "$remote_tag" ]] || fail "remote tag already exists: $tag"

printf 'release: running make check...\n'
make check

command -v actionlint >/dev/null 2>&1 || {
  fail "actionlint is required; install it before releasing"
}
printf 'release: validating GitHub Actions workflows...\n'
actionlint .github/workflows/release.yml .github/workflows/docker.yml
ensure_clean

if [[ "$dry_run" == 1 ]]; then
  printf 'release: dry run complete; no tag was created or pushed\n'
  exit 0
fi

printf 'release: creating annotated tag %s...\n' "$tag"
git tag -a "$tag" -m "chore: release $tag"

printf 'release: pushing only refs/tags/%s...\n' "$tag"
if ! git push origin "refs/tags/$tag"; then
  printf 'release: push failed; local tag %s was kept for diagnosis or retry\n' "$tag" >&2
  exit 1
fi

printf 'release: tag %s pushed; GitHub Actions will run the release workflow\n' "$tag"
